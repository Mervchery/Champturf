# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run the scraper (scraper/scrape.mjs) — NEVER prefix this
# with NEXT_PUBLIC_ or reference it from anything in app/ or components/.
# It bypasses row-level security entirely. Find it in Supabase:
# Settings → API → service_role secret ("Reveal" to see it).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
