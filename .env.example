# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run the scraper (scraper/scrape.mjs) — NEVER prefix this
# with NEXT_PUBLIC_ or reference it from anything in app/ or components/.
# It bypasses row-level security entirely. Find it in Supabase:
# Settings → API → service_role secret ("Reveal" to see it).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Optional — only needed for the admin "Auto-find on YouTube" replay
# button (app/races/[id], via lib/actions/races.ts). Without this, admins
# can still paste a YouTube URL manually; nothing else is affected.
# Get one free at https://console.cloud.google.com/apis/credentials after
# enabling "YouTube Data API v3" for a project — see README.md's
# "Race replays (YouTube)" section for the full walkthrough and quota notes.
YOUTUBE_API_KEY=your-youtube-data-api-key

# Optional — scraper only. Used to translate the French "Racing Notes" into
# English with horse/jockey/trainer names protected. Without it the scraper
# falls back to a free translation service (lower quality, rate-limited).
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Used in the scraper's User-Agent so site owners can reach you. Use a real email.
SCRAPER_CONTACT=you@yourdomain.com

# Social sign-in buttons shown on /login (comma separated). Each must also be enabled in
# Supabase -> Authentication -> Providers. Default: google
# NEXT_PUBLIC_AUTH_PROVIDERS=google

# Public address of the site (no trailing slash). Used for canonical links, sitemap.xml,
# the share image and links inside notifications. Set it in Vercel as well.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Race-day push notifications (web push). Generate ONE pair with:  npm run gen:vapid
# The public key is safe in the browser; the private key must stay secret (never NEXT_PUBLIC_).
# Add all three to .env.local, to Vercel (public key only is needed there) and to the
# GitHub repo secrets (all three) — the scheduled job sends the notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@yourdomain.com

# Optional tuning for follower odds alerts (scraper/alerts.mjs)
# ALERT_ODDS_MIN_PCT=0.15        # price must move by at least 15%
# ALERT_ODDS_WINDOW_MIN=60       # ignore moves older than this
# ALERT_ODDS_COOLDOWN_MIN=15     # max one odds alert per member+horse+race per 15 min
